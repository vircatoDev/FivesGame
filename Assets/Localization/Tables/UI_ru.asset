      m_Items: []
  - m_Id: 2895326994446
    m_Localized: "\u0421\u043E\u0431\u0430\u043A\u0438"
    m_Metadata:
      m_Items: []
  - m_Id: 2895326994447
    m_Localized: "\u041A\u043E\u0448\u043A\u0438"
    m_Metadata:
      m_Items: []
  - m_Id: 2895326994448
    m_Localized: "\u041F\u0438\u0442\u043E\u043C\u0446\u044B"
    m_Metadata:
      m_Items: []
  - m_Id: 2895326994449
    m_Localized: "\u041A\u043E\u0440\u0433\u0438"
    m_Metadata:
      m_Items: []
  - m_Id: 2895326994450
    m_Localized: "\u041A\u043E\u0440\u0433\u0438 - \u043C\u0430\u043B\u0435\u043D\u044C\u043A\u0430\u044F
      \u043F\u0430\u0441\u0442\u0443\u0448\u044C\u044F \u0441\u043E\u0431\u0430\u043A\u0430.
      \u041E\u043D\u0430 \u043F\u043E\u043C\u043E\u0433\u0430\u043B\u0430 \u0432\u0430\u043B\u043B\u0438\u0439\u0441\u043A\u0438\u043C
      \u0444\u0435\u0440\u043C\u0435\u0440\u0430\u043C \u043F\u0430\u0441\u0442\u0438
      \u043E\u0432\u0435\u0446."
    m_Metadata:
      m_Items: []
  - m_Id: 2895326994451
    m_Localized: "\u041C\u043E\u043F\u0441"
    m_Metadata:
      m_Items: []
  - m_Id: 2895326994452
    m_Localized: "\u041C\u043E\u043F\u0441 - \u043A\u0440\u0435\u043F\u043A\u0430\u044F
      \u0441\u043E\u0431\u0430\u043A\u0430 \u0441 \u043A\u0432\u0430\u0434\u0440\u0430\u0442\u043D\u044B\u043C
      \u0442\u0435\u043B\u043E\u043C."
    m_Metadata:
      m_Items: []
  - m_Id: 2895326994453
    m_Localized: "\u041E\u0432\u0447\u0430\u0440\u043A\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 2895326994454
    m_Localized: "\u041D\u0435\u043C\u0435\u0446\u043A\u0430\u044F \u043E\u0432\u0447\u0430\u0440\u043A\u0430
      - \u043F\u0430\u0441\u0442\u0443\u0448\u044C\u044F \u0441\u043E\u0431\u0430\u043A\u0430,
      \u0438\u0437\u0432\u0435\u0441\u0442\u043D\u0430\u044F \u0441\u043C\u0435\u043B\u043E\u0441\u0442\u044C\u044E,
      \u0432\u0435\u0440\u043D\u043E\u0441\u0442\u044C\u044E \u0438 \u0443\u043C\u0435\u043D\u0438\u0435\u043C
      \u0437\u0430\u0449\u0438\u0449\u0430\u0442\u044C."
    m_Metadata:
      m_Items: []
  - m_Id: 2895326994455
    m_Localized: "\u0421\u0438\u0430\u043C\u0441\u043A\u0430\u044F"
    m_Metadata:
      m_Items: []
  - m_Id: 2895326994456
    m_Localized: "\u0423 \u0441\u0438\u0430\u043C\u0441\u043A\u043E\u0439 \u043A\u043E\u0448\u043A\u0438
      \u044F\u0440\u043A\u043E-\u0433\u043E\u043B\u0443\u0431\u044B\u0435 \u0433\u043B\u0430\u0437\u0430
      \u0438 \u0442\u0435\u043C\u043D\u044B\u0435 \u0443\u0448\u043A\u0438, \u043B\u0430\u043F\u043A\u0438
      \u0438 \u0445\u0432\u043E\u0441\u0442."
    m_Metadata:
      m_Items: []
  - m_Id: 2895326994457
    m_Localized: "\u0411\u0440\u0438\u0442\u0430\u043D\u0441\u043A\u0430\u044F"
    m_Metadata:
      m_Items: []
  - m_Id: 2895326994458
    m_Localized: "\u0411\u0440\u0438\u0442\u0430\u043D\u0441\u043A\u0430\u044F \u043A\u043E\u0440\u043E\u0442\u043A\u043E\u0448\u0435\u0440\u0441\u0442\u043D\u0430\u044F
      - \u0441\u043F\u043E\u043A\u043E\u0439\u043D\u0430\u044F \u0438 \u043B\u0430\u0441\u043A\u043E\u0432\u0430\u044F
      \u043A\u043E\u0448\u043A\u0430 \u0441 \u0433\u0443\u0441\u0442\u043E\u0439
      \u0441\u0435\u0440\u043E\u0439 \u0448\u0435\u0440\u0441\u0442\u044C\u044E."
    m_Metadata:
      m_Items: []
  - m_Id: 2895326994459
    m_Localized: "\u0420\u044B\u0436\u0438\u0439"
    m_Metadata:
      m_Items: []
  - m_Id: 2895326994460
    m_Localized: "\u0423 \u0440\u044B\u0436\u0438\u0445 \u043A\u043E\u0442\u043E\u0432
      \u0442\u0435\u043F\u043B\u0430\u044F \u043E\u0440\u0430\u043D\u0436\u0435\u0432\u0430\u044F
      \u0448\u0435\u0440\u0441\u0442\u044C \u0432 \u043F\u043E\u043B\u043E\u0441\u043A\u0443,
      \u0438 \u043E\u043D\u0438 \u043E\u0431\u043E\u0436\u0430\u044E\u0442 \u0438\u0433\u0440\u0430\u0442\u044C."
    m_Metadata:
      m_Items: []
  - m_Id: 2895326994461
    m_Localized: "\u0411\u0438\u0441\u043A\u0432\u0438\u0442"
    m_Metadata:
      m_Items: []
  - m_Id: 2895326994462
    m_Localized: "\u0411\u0438\u0441\u043A\u0432\u0438\u0442 - \u0432\u0435\u0441\u0435\u043B\u044B\u0439
      \u043A\u043E\u0440\u0433\u0438, \u043A\u043E\u0442\u043E\u0440\u044B\u0439
      \u043E\u0431\u043E\u0436\u0430\u0435\u0442 \u0434\u043E\u043B\u0433\u0438\u0435
      \u043F\u0440\u043E\u0433\u0443\u043B\u043A\u0438 \u0438 \u043A\u043E\u0433\u0434\u0430
      \u0435\u043C\u0443 \u0447\u0435\u0448\u0443\u0442 \u0436\u0438\u0432\u043E\u0442\u0438\u043A."
    m_Metadata:
      m_Items: []
  - m_Id: 2895326994463
    m_Localized: "\u041B\u0443\u043D\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 2895326994464
    m_Localized: "\u041B\u0443\u043D\u0430 - \u043B\u044E\u0431\u043E\u043F\u044B\u0442\u043D\u044B\u0439
      \u0441\u0438\u0430\u043C\u0441\u043A\u0438\u0439 \u043A\u043E\u0442\u0435\u043D\u043E\u043A
      \u0441 \u043D\u0435\u0431\u0435\u0441\u043D\u043E-\u0433\u043E\u043B\u0443\u0431\u044B\u043C\u0438
      \u0433\u043B\u0430\u0437\u0430\u043C\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 2895326994465
    m_Localized: "\u041C\u0430\u0444\u0444\u0438\u043D"
    m_Metadata:
      m_Items: []
  - m_Id: 2895331188736
    m_Localized: "\u041C\u0430\u0444\u0444\u0438\u043D - \u043E\u0437\u043E\u0440\u043D\u0430\u044F
      \u043C\u043E\u043F\u0441\u0438\u0445\u0430, \u043A\u043E\u0442\u043E\u0440\u0430\u044F
      \u0445\u0440\u0430\u043F\u0438\u0442 \u0432\u043E \u0441\u043D\u0435."
    m_Metadata:
      m_Items: []
  - m_Id: 2895331188737
    m_Localized: "\u0414\u044B\u043C\u043E\u043A"
    m_Metadata:
      m_Items: []
  - m_Id: 2895331188738
    m_Localized: "\u0414\u044B\u043C\u043E\u043A - \u043F\u0443\u0448\u0438\u0441\u0442\u044B\u0439
      \u0441\u0435\u0440\u044B\u0439 \u043A\u043E\u0442, \u043A\u043E\u0442\u043E\u0440\u044B\u0439
      \u043B\u044E\u0431\u0438\u0442 \u0442\u0435\u043F\u043B\u043E\u0435 \u0441\u043E\u043B\u043D\u0435\u0447\u043D\u043E\u0435
      \u043C\u0435\u0441\u0442\u0435\u0447\u043A\u043E."
    m_Metadata:
      m_Items: []
  - m_Id: 2895331188739
    m_Localized: "\u0420\u0435\u043A\u0441"
    m_Metadata:
      m_Items: []
  - m_Id: 2895331188740
    m_Localized: "\u0420\u0435\u043A\u0441 - \u0441\u043C\u0435\u043B\u0430\u044F
      \u043E\u0432\u0447\u0430\u0440\u043A\u0430, \u043A\u043E\u0442\u043E\u0440\u0430\u044F
      \u0432\u0441\u0435\u0433\u0434\u0430 \u043E\u0445\u0440\u0430\u043D\u044F\u0435\u0442
      \u0441\u0430\u0434."
    m_Metadata:
      m_Items: []
  - m_Id: 2895331188741
    m_Localized: "\u0422\u0438\u0433\u0440"
    m_Metadata:
      m_Items: []
  - m_Id: 2895331188742
    m_Localized: "\u0422\u0438\u0433\u0440 - \u0438\u0433\u0440\u0438\u0432\u044B\u0439
      \u0440\u044B\u0436\u0438\u0439 \u043A\u043E\u0442\u0435\u043D\u043E\u043A,
      \u043A\u043E\u0442\u043E\u0440\u044B\u0439 \u0433\u043E\u043D\u044F\u0435\u0442\u0441\u044F
      \u0437\u0430 \u0431\u0430\u0431\u043E\u0447\u043A\u0430\u043C\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 25938183053312
    m_Localized: "\u0412\u044B\u0431\u0435\u0440\u0438<br>\u0441\u0432\u043E\u044E<br>\u0442\u0435\u043C\u0443!"
    m_Metadata:
      m_Items: []
  references:
    version: 2
