  - m_Id: 2895326994446
    m_Localized: Perros
    m_Metadata:
      m_Items: []
  - m_Id: 2895326994447
    m_Localized: Gatos
    m_Metadata:
      m_Items: []
  - m_Id: 2895326994448
    m_Localized: Mascotas
    m_Metadata:
      m_Items: []
  - m_Id: 2895326994449
    m_Localized: Corgi
    m_Metadata:
      m_Items: []
  - m_Id: 2895326994450
    m_Localized: "El corgi es un peque\xF1o perro pastor que ayudaba a los granjeros
      galeses con las ovejas."
    m_Metadata:
      m_Items: []
  - m_Id: 2895326994451
    m_Localized: Carlino
    m_Metadata:
      m_Items: []
  - m_Id: 2895326994452
    m_Localized: El carlino es un perro robusto de cuerpo cuadrado.
    m_Metadata:
      m_Items: []
  - m_Id: 2895326994453
    m_Localized: "Pastor alem\xE1n"
    m_Metadata:
      m_Items: []
  - m_Id: 2895326994454
    m_Localized: "El pastor alem\xE1n es un perro pastor valiente, leal y protector."
    m_Metadata:
      m_Items: []
  - m_Id: 2895326994455
    m_Localized: "Siam\xE9s"
    m_Metadata:
      m_Items: []
  - m_Id: 2895326994456
    m_Localized: "El gato siam\xE9s tiene ojos azules brillantes y orejas, patas
      y cola oscuras."
    m_Metadata:
      m_Items: []
  - m_Id: 2895326994457
    m_Localized: "Brit\xE1nico"
    m_Metadata:
      m_Items: []
  - m_Id: 2895326994458
    m_Localized: "El brit\xE1nico de pelo corto es un gato tranquilo y mimoso con
      un pelaje gris espeso."
    m_Metadata:
      m_Items: []
  - m_Id: 2895326994459
    m_Localized: Pelirrojo
    m_Metadata:
      m_Items: []
  - m_Id: 2895326994460
    m_Localized: "Los gatos pelirrojos tienen un c\xE1lido pelaje naranja a rayas
      y les encanta jugar."
    m_Metadata:
      m_Items: []
  - m_Id: 2895326994461
    m_Localized: Biscuit
    m_Metadata:
      m_Items: []
  - m_Id: 2895326994462
    m_Localized: Biscuit es un corgi feliz al que le encantan los paseos largos y
      las caricias en la barriga.
    m_Metadata:
      m_Items: []
  - m_Id: 2895326994463
    m_Localized: Luna
    m_Metadata:
      m_Items: []
  - m_Id: 2895326994464
    m_Localized: Luna es una gatita siamesa curiosa de ojos azul cielo.
    m_Metadata:
      m_Items: []
  - m_Id: 2895326994465
    m_Localized: Muffin
    m_Metadata:
      m_Items: []
  - m_Id: 2895331188736
    m_Localized: Muffin es una carlina traviesa que ronca cuando duerme.
    m_Metadata:
      m_Items: []
  - m_Id: 2895331188737
    m_Localized: Smokey
    m_Metadata:
      m_Items: []
  - m_Id: 2895331188738
    m_Localized: "Smokey es un gato gris y esponjoso al que le encantan los rincones
      c\xE1lidos y soleados."
    m_Metadata:
      m_Items: []
  - m_Id: 2895331188739
    m_Localized: Rex
    m_Metadata:
      m_Items: []
  - m_Id: 2895331188740
    m_Localized: "Rex es un pastor valiente que siempre vigila el jard\xEDn."
    m_Metadata:
      m_Items: []
  - m_Id: 2895331188741
    m_Localized: Tigre
    m_Metadata:
      m_Items: []
  - m_Id: 2895331188742
    m_Localized: "Tigre es un gatito pelirrojo juguet\xF3n que persigue mariposas."
    m_Metadata:
      m_Items: []
  - m_Id: 25938183053312
    m_Localized: "\xA1Elige<br>tu<br>tema!"
    m_Metadata:
      m_Items: []
