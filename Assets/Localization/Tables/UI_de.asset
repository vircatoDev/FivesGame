  - m_Id: 2895326994448
    m_Localized: Haustiere
    m_Metadata:
      m_Items: []
  - m_Id: 2895326994449
    m_Localized: Corgi
    m_Metadata:
      m_Items: []
  - m_Id: 2895326994450
    m_Localized: "Der Corgi ist ein kleiner H\xFCtehund, der walisischen Bauern beim
      Schafeh\xFCten half."
    m_Metadata:
      m_Items: []
  - m_Id: 2895326994451
    m_Localized: Mops
    m_Metadata:
      m_Items: []
  - m_Id: 2895326994452
    m_Localized: "Der Mops ist ein kr\xE4ftiger Hund mit quadratischem K\xF6rper."
    m_Metadata:
      m_Items: []
  - m_Id: 2895326994453
    m_Localized: "Sch\xE4ferhund"
    m_Metadata:
      m_Items: []
  - m_Id: 2895326994454
    m_Localized: "Der Deutsche Sch\xE4ferhund ist ein mutiger, treuer und besch\xFCtzender
      H\xFCtehund."
    m_Metadata:
      m_Items: []
  - m_Id: 2895326994455
    m_Localized: Siamkatze
    m_Metadata:
      m_Items: []
  - m_Id: 2895326994456
    m_Localized: Die Siamkatze hat leuchtend blaue Augen und dunkle Ohren, Pfoten
      und einen dunklen Schwanz.
    m_Metadata:
      m_Items: []
  - m_Id: 2895326994457
    m_Localized: Britisch Kurzhaar
    m_Metadata:
      m_Items: []
  - m_Id: 2895326994458
    m_Localized: Die Britisch Kurzhaar ist eine ruhige, verschmuste Katze mit dichtem
      grauem Fell.
    m_Metadata:
      m_Items: []
  - m_Id: 2895326994459
    m_Localized: Rote Katze
    m_Metadata:
      m_Items: []
  - m_Id: 2895326994460
    m_Localized: Rote Katzen haben warmes, gestreiftes orangefarbenes Fell und spielen
      gern.
    m_Metadata:
      m_Items: []
  - m_Id: 2895326994461
    m_Localized: Biscuit
    m_Metadata:
      m_Items: []
  - m_Id: 2895326994462
    m_Localized: "Biscuit ist ein fr\xF6hlicher Corgi, der lange Spazierg\xE4nge
      und Bauchkraulen liebt."
    m_Metadata:
      m_Items: []
  - m_Id: 2895326994463
    m_Localized: Luna
    m_Metadata:
      m_Items: []
  - m_Id: 2895326994464
    m_Localized: "Luna ist ein neugieriges Siamk\xE4tzchen mit himmelblauen Augen."
    m_Metadata:
      m_Items: []
  - m_Id: 2895326994465
    m_Localized: Muffin
    m_Metadata:
      m_Items: []
  - m_Id: 2895331188736
    m_Localized: Muffin ist eine freche Mopsdame, die im Schlaf schnarcht.
    m_Metadata:
      m_Items: []
  - m_Id: 2895331188737
    m_Localized: Smokey
    m_Metadata:
      m_Items: []
  - m_Id: 2895331188738
    m_Localized: "Smokey ist ein flauschiger grauer Kater, der warme Sonnenpl\xE4tze
      liebt."
    m_Metadata:
      m_Items: []
  - m_Id: 2895331188739
    m_Localized: Rex
    m_Metadata:
      m_Items: []
  - m_Id: 2895331188740
    m_Localized: "Rex ist ein mutiger Sch\xE4ferhund, der immer den Garten bewacht."
    m_Metadata:
      m_Items: []
  - m_Id: 2895331188741
    m_Localized: Tiger
    m_Metadata:
      m_Items: []
  - m_Id: 2895331188742
    m_Localized: "Tiger ist ein verspieltes rotes K\xE4tzchen, das Schmetterlingen
      nachjagt."
    m_Metadata:
      m_Items: []
  - m_Id: 25938183053312
    m_Localized: "W\xE4hle<br>dein<br>Thema!"
    m_Metadata:
      m_Items: []
