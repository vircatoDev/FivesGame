  m_text: "\u041D\u0435\u043C\u0435\u0446\u043A\u0438\u0435 \u043E\u0432\u0447\u0430\u0440\u043A\u0438
    \u2013 \u0441\u043E\u0431\u0430\u043A\u0438 \u043A\u0440\u0435\u043F\u043A\u043E\u0433\u043E
    \u0441\u043F\u043E\u0440\u0442\u0438\u0432\u043D\u043E\u0433\u043E \u0442\u0435\u043B\u043E\u0441\u043B\u043E\u0436\u0435\u043D\u0438\u044F.
    \u0413\u043E\u043B\u043E\u0432\u0430 \u043A\u043B\u0438\u043D\u043E\u043E\u0431\u0440\u0430\u0437\u043D\u0430\u044F,
    \u0432\u044B\u0441\u043E\u043A\u0438\u0435 \u0441\u0442\u043E\u044F\u0447\u0438\u0435
    \u0443\u0448\u0438, \u0442\u0435\u043C\u043D\u044B\u0435 \u0433\u043B\u0430\u0437\u0430,
    \u0447\u0435\u0440\u043D\u0430\u044F \u043C\u043E\u0447\u043A\u0430 \u043D\u043E\u0441\u0430,
    \u043C\u0443\u0441\u043A\u0443\u043B\u0438\u0441\u0442\u044B\u0435 \u043A\u043E\u043D\u0435\u0447\u043D\u043E\u0441\u0442\u0438
    \u0441 \u0432\u044B\u0440\u0430\u0436\u0435\u043D\u043D\u044B\u043C\u0438 \u0443\u0433\u043B\u0430\u043C\u0438"
